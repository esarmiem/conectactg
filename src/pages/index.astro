---
// Archivo: src/pages/index.astro
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conecta Cartagena</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow-x: hidden;
        }

        body {
            background: linear-gradient(to bottom, #645c9a, #f18622);
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .background-container {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 100vw;
            max-height: 100vh;
        }

        .background-image {
            width: 100%;
            height: 100%;
            background-image: url('/background2.webp');
            background-position: center;
            background-repeat: no-repeat;
            background-size: contain;
            background-color: transparent; /* Cambiado de white a transparent */
        }

        @media screen and (orientation: portrait) {
            .background-image {
                background-size: contain;
                max-width: 100%;
                max-height: 100%;
            }
        }

        @media screen and (orientation: landscape) {
            .background-image {
                background-size: contain;
                max-width: 100%;
                max-height: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="background-container">
        <div class="background-image"></div>
    </div>
</body>
</html>